####################################
# Django
####################################
# Required. Generate a fresh one, never reuse a key that has been in source:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Optional. Signs the app's own JWTs (HAC/jwt_utils.py).
# Leave blank to fall back to SECRET_KEY.
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256

DEBUG=False
ALLOWED_HOSTS=

####################################
# PostgreSQL
####################################
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

####################################
# Email
####################################
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

####################################
# Redis
####################################
REDIS_HOST=
REDIS_PORT=6379

####################################
# AWS S3
####################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

####################################
# Firebase Cloud Messaging
####################################
FCM_PROJECT_ID=
FCM_PRIVATE_KEY_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
FCM_CLIENT_ID=

####################################
# SMS OTP Provider (2Factor)
####################################
API_KEY=
